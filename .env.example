# Generate your own .env using scripts/init_local_config.py.
# This file intentionally contains no usable credentials.
APP_ENV=development
RUNTIME_EXECUTION_LOCATION=local
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
STORAGE_PATH=./storage
LOG_PATH=./logs
JOB_CONCURRENCY_PRESET=low
# Use absolute executable paths if these tools are not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
JWT_SECRET=
PROVIDER_ENCRYPTION_KEY=
EPISODE_PLANNING_EPOCH=
